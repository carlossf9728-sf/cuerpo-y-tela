# Copia este archivo como `.env.local` para desarrollo, y pon las mismas
# variables en Vercel → Settings → Environment Variables para producción.
# Sin ninguna de ellas la web funciona igual: las valoraciones y la newsletter
# se guardan en memoria (se pierden al reiniciar) y no se mide nada.

# --- Base de datos (valoraciones de lectores y newsletter) -------------------
# Vercel → Storage → Upstash Redis las define solas al conectar la base de datos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Estadísticas de visitas (Plausible, sin cookies) -----------------------
# El dominio tal y como lo diste de alta en plausible.io.
NEXT_PUBLIC_ANALITICA_DOMINIO=
# Solo si usas un Plausible propio o un proxy; si no, déjalo vacío.
NEXT_PUBLIC_ANALITICA_SRC=

# --- Newsletter --------------------------------------------------------------
# Contraseña para descargar la lista de suscriptoras en CSV:
#   https://cuerpoytela.com/api/newsletter?clave=LO-QUE-PONGAS-AQUI
# Si la dejas vacía, esa descarga no existe (devuelve 404).
NEWSLETTER_CLAVE=
